{
  "name": "examonline-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:api": "openapi-ts",
    "type-check:app": "npm run type-check:app:check -- --watch",
    "type-check:app:check": "vue-tsc --project ./tsconfig.app.json --noEmit",
    "type-check:config": "npm run type-check:config:check -- --watch",
    "type-check:config:check": "tsc --project ./tsconfig.config.json --noEmit",
    "type-check": "npm run type-check:app & npm run type-check:config",
    "type-check:check": "npm run type-check:app:check & npm run type-check:config:check",
    "lint": "eslint --fix src e2e *.config.ts",
    "lint:check": "eslint src e2e *.config.ts",
    "format": "prettier --write src e2e *.config.ts *.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "precommit:check": "npm run type-check:check && npm run lint:check"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@hey-api/client-axios": "^0.9.1",
    "@tanstack/vue-query": "^5.91.1",
    "ant-design-vue": "~4.2.6",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "unplugin-vue-router": "^0.19.2",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@hey-api/openapi-ts": "^0.97.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.2",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["core-js", "esbuild", "vue-demi"]
  }
}
