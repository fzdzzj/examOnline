# ==== Maven ====
target/
!.mvn/wrapper/maven-wrapper.jar
*.class

# ==== 本地依赖缓存（不应进版本库）====
.m2-repo/

# ==== IDE ====
.idea/
*.iml
.vscode/
*.swp
*.swo
.settings/
.classpath
.project
.factorypath

# ==== 日志与临时文件 ====
*.log
*.tmp
*.bak
logs/

# ==== 系统文件 ====
.DS_Store
Thumbs.db

# ==== 环境敏感配置 ====
.env
application-local.yml

# ==== 工具工作目录 ====
# .workbuddy/ 是 WorkBuddy 的项目记忆（MEMORY.md + 每日工作日志），属工具产物而非
# 项目代码：它随开发者的机器与工具走，入库只会给协作者制造无意义的 diff。
.workbuddy/
# .qoder/ 是 Qoder agent 的会话产物（better-harness 报告与画布等），同理不入库。
# 某份报告确实要留档时，显式 `git add` 那一个文件，不要为此放开整个目录。
.qoder/

# ==== 前端（frontend/，阶段 19 起）====
# 依赖与构建产物一律不入库：体积大、跨平台二进制不一致，且都能由 pnpm install / build 复原。
frontend/node_modules/
frontend/dist/
frontend/coverage/
# 测试与工具的临时产物
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.vite/
# vite 插件生成的类型声明：由 dev/build 产出，不入库以免与路由文件频繁冲突
frontend/typed-router.d.ts
frontend/auto-imports.d.ts
frontend/components.d.ts
# e2e 账号凭据（frontend/e2e/.env 含明文口令，只提交 .env.example）
# 注：上方 `.env` 规则已覆盖，这里显式写出以防后续规则被改动
frontend/e2e/.env