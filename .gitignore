# ==== Maven ====
target/
!.mvn/wrapper/maven-wrapper.jar
*.class

# ==== 本地依赖缓存（不应进版本库）====
.m2-repo/

# ==== IDE ====
.idea/
*.iml
.vscode/
*.swp
*.swo
.settings/
.classpath
.project
.factorypath

# ==== 日志与临时文件 ====
*.log
*.tmp
*.bak
logs/

# ==== 系统文件 ====
.DS_Store
Thumbs.db

# ==== 环境敏感配置 ====
.env
application-local.yml

# ==== 工具工作目录 ====
# .workbuddy/ 是 WorkBuddy 的项目记忆（MEMORY.md + 每日工作日志），属工具产物而非
# 项目代码：它随开发者的机器与工具走，入库只会给协作者制造无意义的 diff。
.workbuddy/