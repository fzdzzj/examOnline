# ==== Maven ====
target/
!.mvn/wrapper/maven-wrapper.jar
*.class

# ==== 本地依赖缓存（不应进版本库）====
.m2-repo/

# ==== IDE ====
.idea/
*.iml
.vscode/
*.swp
*.swo
.settings/
.classpath
.project
.factorypath

# ==== 日志与临时文件 ====
*.log
*.tmp
*.bak
logs/
# 证据日志例外：spec/changes 下归档证据清单（evidence-sha256.txt）承诺可在新克隆上
# 用 `grep -v '^#' evidence-sha256.txt | sha256sum -c -` 复验，证据日志本身必须入库；
# 该负向规则只放开 evidence/ 目录一层，不涉及其他运行日志。
!spec/changes/**/evidence/*.log

# ==== 系统文件 ====
.DS_Store
Thumbs.db

# ==== 环境敏感配置 ====
.env
application-local.yml

# ==== 自签证书产物（add-deployment-stack）====
# docker/certs/generate-selfsigned.sh 生成的自签证书本体：只用于本地 HTTPS 冒烟，
# 真实证书替换是后续人工动作；证书一律不入库。
docker/certs/out/

# ==== MySQL 备份产物（add-backup-restore-drill）====
# docker/mysql/backup/backup.sh 产出的全量 dump（.sql.gz + .sha256）只落本机，不入库；
# 是否/何时备份以 BACKUPS.md 台账为准，脚本入库 ≠ 备份已运行。
docker/mysql/backup/out/

# ==== 工具工作目录 ====
# .workbuddy/ 是 WorkBuddy 的项目记忆（MEMORY.md + 每日工作日志），属工具产物而非
# 项目代码：它随开发者的机器与工具走，入库只会给协作者制造无意义的 diff。
.workbuddy/
# .qoder/ 是 Qoder agent 的会话产物（better-harness 报告与画布等），同理不入库。
# 某份报告确实要留档时，显式 `git add` 那一个文件，不要为此放开整个目录。
.qoder/
# .codex/ 与 .trae/ 分别是 Codex、Trae 两个 agent 工具的本地会话与配置产物，
# 同属工具产物而非项目代码，入库只会给协作者制造噪音，故忽略。
.codex/
.trae/

# ==== 前端（frontend/，阶段 19 起）====
# 依赖与构建产物一律不入库：体积大、跨平台二进制不一致，且都能由 pnpm install / build 复原。
frontend/node_modules/
frontend/dist/
frontend/coverage/
# 测试与工具的临时产物
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.vite/
# .playwright-cli/ 是 playwright-cli 的本地工作目录、output/ 是脚本运行输出，均为本地运行产物，不入库
frontend/.playwright-cli/
frontend/output/
# vite 插件生成的类型声明：由 dev/build 产出，不入库以免与路由文件频繁冲突
frontend/typed-router.d.ts
frontend/auto-imports.d.ts
frontend/components.d.ts
# e2e 账号凭据（frontend/e2e/.env 含明文口令，只提交 .env.example）
# 注：上方 `.env` 规则已覆盖，这里显式写出以防后续规则被改动
frontend/e2e/.env

# ==== 题干图片存储（add-question-image）====
# 上传端点默认落 ./data/question-images（exam.question-image.dir 可环境变量覆盖）；
# 图片是运行时业务数据（含用户上传内容），一律不入库；物理清理另行立项（proposal 边界）。
data/