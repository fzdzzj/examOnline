=== n=200 OLD main bytes=4281440 rows=200 exit=0 select=id,exam_id,student_id,start_time,deadline_time,submit_time,submit_type,paper_json,answers,status,version,created_time,updated_time
SELECT COALESCE(SUM(COALESCE(LENGTH(CAST(id AS CHAR)),0) + COALESCE(LENGTH(CAST(exam_id AS CHAR)),0) + COALESCE(LENGTH(CAST(student_id AS CHAR)),0) + COALESCE(LENGTH(CAST(start_time AS CHAR)),0) + COALESCE(LENGTH(CAST(deadline_time AS CHAR)),0) + COALESCE(LENGTH(CAST(submit_time AS CHAR)),0) + COALESCE(LENGTH(CAST(submit_type AS CHAR)),0) + COALESCE(LENGTH(CAST(paper_json AS CHAR)),0) + COALESCE(LENGTH(CAST(answers AS CHAR)),0) + COALESCE(LENGTH(CAST(status AS CHAR)),0) + COALESCE(LENGTH(CAST(version AS CHAR)),0) + COALESCE(LENGTH(CAST(created_time AS CHAR)),0) + COALESCE(LENGTH(CAST(updated_time AS CHAR)),0)),0) AS bytes, COUNT(*) AS `rows` FROM (SELECT  id,exam_id,student_id,start_time,deadline_time,submit_time,submit_type,paper_json,answers,status,version,created_time,updated_time  FROM exam_submissions      WHERE  (exam_id = 976000200)) t;

=== n=200 PROJ main bytes=2000 rows=200 exit=0 select=student_id,status
